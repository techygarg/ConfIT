{
  "ShouldValidateUserFieldsWithSemanticMatchers": {
    "tags": ["user", "semantic"],
    "api": {
      "request": {
        "method": "GET",
        "path": "/api/user/test@test.com"
      },
      "response": {
        "statusCode": 200,
        "body": {
          "name": "test"
        },
        "matcher": {
          "semantic": {
            "id": "greaterThan(0)",
            "email": "isEmail",
            "age": "greaterThan(0)",
            "name": "hasLength(1,100)"
          }
        }
      }
    }
  }
}
